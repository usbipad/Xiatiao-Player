# Python 缓存
__pycache__/
*.pyc

# Rust 构建产物
audio_backend_rs/target/

# cargo vendor 生成的依赖副本（可由 `cargo vendor` 重建，不纳入版本控制）
audio_backend_rs/vendor/

# Unix socket
*.sock

# 工具目录的构建产物（camilladsp 源码本身保留，便于离线构建）
tools/camilladsp-src/target/

# 第三方源码中的非构建必需目录（CI / 编辑器配置）
tools/camilladsp-src/.github/
tools/camilladsp-src/.vscode/

# 本地代码快照备份
backups/

# 补丁残留文件（*.bak / *.tmp / *.orig / *.pre_* / 编辑器临时文件）
*.bak
*.bak_*
*.tmp
*.orig
*.pre_*
*~

# 应用图标源图（生成物 data/icons/*.png 已入库；源图不入库）
image.png

# 界面展示截图（README/发布展示用，不入库）
界面截图/

# Debian 打包构建产物（仅 debian/ 下的源配置入库）
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/*.substvars
debian/xiatiao-player/
debian/tmp/

# deb 包产物（若在仓库内构建）
*.deb
*.buildinfo
*.changes
*.dsc
# sbuild 构建日志（形如 pkg_ver_arch-<时间戳>.build）
*.build

# AppImage 构建产物（tools/build_appimage.sh 生成）
*.AppImage
squashfs-root/

# 代码审查/体检记录（本地留存，不入库）
reviews/

# 测试代码（本地留存，不入库）
tests/

# 发布产物目录：产物不入库（可由构建脚本重建），仅保留目录本身
release/*.deb
release/*.AppImage
release/*.rpm
release/*.buildinfo
release/*.changes
release/*.dsc
release/*.build
