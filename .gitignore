# Python 缓存
__pycache__/
*.pyc

# Rust 构建产物
audio_backend_rs/target/

# Unix socket
*.sock

# 工具目录的构建产物（camilladsp 源码本身保留，便于离线构建）
tools/camilladsp-src/target/
tools/pwrs-check/target/
tools/pwrs-check/Cargo.lock

# CamillaDSP 预编译二进制（构建/下载产物，不入库）
tools/camilladsp/camilladsp

# 第三方源码中的非构建必需目录（CI / 编辑器配置）
tools/camilladsp-src/.github/
tools/camilladsp-src/.vscode/

# 嵌套 git 仓库（自带版本控制，不纳入主仓库）
tools/pwrs-check/

# 本地代码快照备份
backups/

# 补丁残留文件（*.bak / *.tmp / *.orig / *.pre_* / 编辑器临时文件）
*.bak
*.bak_*
*.tmp
*.orig
*.pre_*
*~

# 应用图标源图（生成物 data/icons/*.png 已入库；源图不入库）
image.png

# Debian 打包构建产物（仅 debian/ 下的源配置入库）
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/*.substvars
debian/xiatiao-player/
debian/tmp/

# deb 包产物（若在仓库内构建）
*.deb
*.buildinfo
*.changes
*.dsc
