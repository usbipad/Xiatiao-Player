# Rust 后端二进制为静态链接 libyaml（camillalib 依赖），属正常情况。
xiatiao-player: embedded-library libyaml [usr/lib/xiatiao-player/xiatiao-audio-backend]
# Rust 二进制自带 libc 静态部分，lintian 误报缺 libc 依赖。
xiatiao-player: missing-dependency-on-libc needed by usr/lib/xiatiao-player/xiatiao-audio-backend
# 启动器 /usr/bin/xiatiao-player 是本包提供的脚本，lintian 对 sh 包装脚本偶报此警告。
xiatiao-player: desktop-command-not-in-package /usr/bin/xiatiao-player [usr/share/applications/com.xiatiao.player.desktop]
