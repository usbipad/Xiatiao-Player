# dpkg-source 排除规则。
# native 格式下 .gitignore 不生效，必须在此声明；用 tar-ignore（tar --exclude 语法）。
tar-ignore = __pycache__
tar-ignore = *.pyc
tar-ignore = .git
tar-ignore = .debhelper
tar-ignore = backups
tar-ignore = 界面截图
tar-ignore = image.png
tar-ignore = *.sock
tar-ignore = *.AppImage
tar-ignore = *.deb
tar-ignore = *.buildinfo
tar-ignore = *.changes
tar-ignore = *.dsc
tar-ignore = *.substvars
tar-ignore = audio_backend_rs/target
# 注：不写 tar-ignore = release —— tar 的 --exclude 会匹配任意路径中
# 名为 release 的目录，误伤 vendor/yaml_serde/util/release。
# release/ 产物里的 *.deb 已由下方 tar-ignore = *.deb 排除。
